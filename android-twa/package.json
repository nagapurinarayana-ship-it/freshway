{
  "name": "freshway-android-twa",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated Android Trusted Web Activity wrapper configuration for FreshWay.",
  "scripts": {
    "check:config": "node scripts/validate-config.mjs",
    "validate:live": "npx --yes @bubblewrap/cli@1.27.0 validate --url=https://fwcoldpressed.in",
    "init": "npx --yes @bubblewrap/cli@1.27.0 init --manifest=https://fwcoldpressed.in/manifest.webmanifest --directory=./generated",
    "update": "npx --yes @bubblewrap/cli@1.27.0 update --manifest=./generated",
    "build": "npx --yes @bubblewrap/cli@1.27.0 build --manifest=./generated",
    "generate:assetlinks": "node scripts/generate-assetlinks.mjs"
  }
}
