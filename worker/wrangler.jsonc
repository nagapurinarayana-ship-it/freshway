{
  "name": "freshway-api",
  "main": "src/admin-auth.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freshway",
      "database_id": "4b645f26-12ad-4805-bf22-12186122ad3a"
    }
  ],
  "vars": {
    "FRESHWAY_ENVIRONMENT": "production",
    "APP_ORIGIN": "https://fwcoldpressed.in",
    "APP_ORIGINS": "https://fwcoldpressed.in,https://freshway-f32.pages.dev"
  },
  // Optional Worker secret: GOOGLE_MAPS_BROWSER_API_KEY. Configure a referrer-restricted browser key for Maps JavaScript API and Places API to enable Google Maps in Owner settings. When unset, the existing OpenStreetMap picker remains available.
  "secrets": {
    "required": [
      "ADMIN_TOKEN",
      "CUSTOMER_SESSION_SECRET",
      "ADMIN_SESSION_SECRET",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "VAPID_SUBJECT"
    ]
  }
}
