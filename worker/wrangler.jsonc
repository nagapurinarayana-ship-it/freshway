{
  "name": "freshway-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {"binding": "DB", "database_name": "freshway", "database_id": "REPLACE_WITH_D1_DATABASE_ID"}
  ],
  "vars": {
    "APP_ORIGIN": "https://YOUR-FRESHWAY-DOMAIN"
  }
}
